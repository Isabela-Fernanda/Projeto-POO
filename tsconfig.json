{
    "compilerOptions": {
        "target": "ES2022",

        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDir": "src",
        "outDir": "dist",

        "strict": true,

        "esModuleInterop": true,

        "forceConsistentCasingInFileNames": true,

        "skipLibCheck": true,

        "types": ["node"],

        "ignoreDeprecations": "6.0",

        "baseUrl": "./src",
        
        "paths": {
            "@app/*": ["app/*"],
            "@combate/*": ["combate/*"],
            "@criacao/*": ["criacao/*"],
            "@inventario/*": ["inventario/*"],
            "@itens/*": ["itens/*"],
            "@pericias/*": ["pericias/*"],
            "@personagens/*": ["personagens/*"],
            "@poderes/*": ["poderes/*"],
            "@save/*": ["save/*"],
            "@mapa/*": ["mapa/*"]
        }
    },

    "include": [
        "src/**/*.ts"
    ]
}